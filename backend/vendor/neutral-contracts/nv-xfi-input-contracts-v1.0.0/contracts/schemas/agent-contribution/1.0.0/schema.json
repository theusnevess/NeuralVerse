{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neuralverse:xfi:contract:agent-contribution:1.0.0",
  "title": "AgentContribution",
  "type": "object",
  "allOf": [{ "$ref": "urn:neuralverse:xfi:common:shared-metadata:1.0.0" }],
  "additionalProperties": true,
  "required": ["schema_name", "schema_version", "minimum_reader_version", "producer_version", "created_at", "contributionId", "generationJobId", "agentId", "agentVersion", "packageId", "packageVersion", "contributionType", "inputDependencies", "payloadSchemaVersion", "structuredPayload", "citationIds", "assetRequestIds", "validationResults", "warnings", "confidence", "createdAt", "metadata"],
  "properties": {
    "schema_name": { "const": "AgentContribution" },
    "schema_version": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" },
    "minimum_reader_version": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" },
    "producer_version": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" },
    "created_at": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/utcTimestamp" },
    "extensions": { "type": "object", "propertyNames": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/extensionKey" }, "additionalProperties": true },
    "contributionId": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/opaqueIdentifier" },
    "generationJobId": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/opaqueIdentifier" },
    "agentId": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/opaqueIdentifier" },
    "agentVersion": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" },
    "packageId": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/opaqueIdentifier" },
    "packageVersion": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" },
    "contributionType": { "enum": ["conceptual_definition", "dependency_analysis", "research_evidence", "application_guidance", "laboratory_observation", "assessment_guidance", "narrative_framing", "curiosity_prompt", "didactic_structure", "governance_finding", "visual_recommendation"] },
    "inputDependencies": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:neuralverse:xfi:contract:agent-contribution:1.0.0#/$defs/dependency" } },
    "payloadSchemaVersion": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" },
    "structuredPayload": { "type": "object", "minProperties": 1, "xfiSemanticStructure": { "requireStructuredMember": true } },
    "citationIds": { "$ref": "urn:neuralverse:xfi:contract:agent-contribution:1.0.0#/$defs/identifiers" },
    "assetRequestIds": { "$ref": "urn:neuralverse:xfi:contract:agent-contribution:1.0.0#/$defs/identifiers" },
    "validationResults": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:neuralverse:xfi:contract:agent-contribution:1.0.0#/$defs/validationResult" } },
    "warnings": { "type": "array", "maxItems": 128, "items": {} },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "createdAt": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/utcTimestamp" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "identifiers": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/opaqueIdentifier" } },
    "dependency": {
      "type": "object", "additionalProperties": true,
      "required": ["kind", "id"],
      "properties": { "kind": { "enum": ["contribution", "source", "citation", "concept", "curriculum_node"] }, "id": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/opaqueIdentifier" } }
    },
    "validationResult": {
      "type": "object", "additionalProperties": true,
      "required": ["status", "valid", "findings"],
      "properties": { "status": { "enum": ["PASS", "PASS_WITH_FINDINGS", "FAIL", "UNKNOWN"] }, "valid": { "type": "boolean" }, "findings": { "type": "array", "maxItems": 256, "items": {} }, "value": {}, "checkedAt": { "type": "string" } }
    }
  }
}
