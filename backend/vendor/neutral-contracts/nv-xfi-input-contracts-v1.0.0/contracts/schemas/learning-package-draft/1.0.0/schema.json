    "title": { "type": "string", "minLength": 1 },
    "curriculumScope": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/scope" },
    "learningObjectives": { "type": "array", "maxItems": 128, "items": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/statement" } },
    "prerequisites": { "type": "array", "maxItems": 256, "items": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/statement" } },
    "competencies": { "type": "array", "maxItems": 128, "items": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/statement" } },
    "expectedDepth": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/expectedDepth" },
    "contributionIds": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/identifiers" },
