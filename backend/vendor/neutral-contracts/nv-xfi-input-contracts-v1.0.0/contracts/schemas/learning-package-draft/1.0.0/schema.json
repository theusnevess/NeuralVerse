  "properties": {
    "schema_name": { "const": "LearningPackageDraft" },
    "schema_version": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" },
    "minimum_reader_version": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" },
    "producer_version": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" },
    "created_at": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/utcTimestamp" },
    "extensions": { "type": "object", "propertyNames": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/extensionKey" }, "additionalProperties": true },
    "packageId": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/opaqueIdentifier" },
