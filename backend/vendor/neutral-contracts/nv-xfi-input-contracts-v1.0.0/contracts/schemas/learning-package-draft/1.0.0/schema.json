        "assessmentSpecVersion": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" },
        "assessmentType": { "type": "string", "minLength": 1 },
        "competencyIds": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/identifiers" },
        "relationship": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/identifiers" }
      }
    },
    "statement": { "type": "object", "additionalProperties": true, "required": ["statement", "required"], "properties": { "statementId": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/id" }, "statement": { "type": "string", "minLength": 1 }, "required": { "type": "boolean" } } },
    "contentBlock": { "type": "object", "additionalProperties": true, "required": ["contentBlockId", "blockVersion", "blockType", "semanticPurpose", "sourceContributionIds", "structuredPayload", "conceptLinks", "curriculumLinks", "citationIds", "assetRequestIds", "accessibilityMetadata", "renderingPriority", "requirementStatus", "lifecycle", "metadata"], "properties": { "contentBlockId": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/id" }, "blockVersion": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" }, "blockType": { "type": "string", "minLength": 1 }, "semanticPurpose": { "type": "string", "minLength": 1 }, "sourceContributionIds": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/identifiers" }, "structuredPayload": {}, "conceptLinks": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/identifiers" }, "curriculumLinks": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/identifiers" }, "citationIds": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/identifiers" }, "assetRequestIds": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/identifiers" }, "accessibilityMetadata": { "type": "object", "additionalProperties": true }, "renderingPriority": { "type": "number", "minimum": 0, "maximum": 100 }, "requirementStatus": { "enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL"] }, "lifecycle": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/lifecycle" }, "metadata": { "type": "object", "additionalProperties": true } } },
    "sourceManifest": { "type": "object", "additionalProperties": true, "required": ["manifestId", "version", "sources"], "properties": { "manifestId": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/id" }, "version": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" }, "sources": { "type": "array", "maxItems": 512, "items": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/source" } } } },
    "source": { "type": "object", "additionalProperties": true, "required": ["sourceId", "title", "kind", "canonicalLocator", "status", "authors", "provenance"], "properties": { "sourceId": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/id" }, "title": { "type": "string", "minLength": 1 }, "kind": { "enum": ["paper", "book", "dataset", "web", "code", "internal", "other"] }, "canonicalLocator": { "type": "string", "minLength": 1 }, "status": { "enum": ["draft", "review", "approved", "published", "deprecated", "archived"] }, "authors": { "type": "array", "maxItems": 64, "items": { "type": "string" } }, "publisher": { "type": "string" }, "publicationYear": { "type": "integer" }, "version": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" }, "license": { "type": ["string", "null"] }, "quality": {}, "provenance": { "type": "object", "additionalProperties": true, "required": ["providedBy", "rationale"], "properties": { "providedBy": { "type": "string" }, "rationale": { "type": "string" } } } } },
    "citation": { "type": "object", "additionalProperties": true, "required": ["citationId", "sourceId", "citationType"], "properties": { "citationId": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/id" }, "sourceId": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/id" }, "citationType": { "enum": ["direct", "paraphrase", "data", "method", "definition", "background"] }, "locator": { "type": "string" }, "claim": { "type": "string" } } },
    "lifecycle": { "type": "object", "additionalProperties": true, "required": ["lifecycle", "version", "approval", "publication"], "properties": { "lifecycle": { "type": "string" }, "version": { "$ref": "urn:neuralverse:xfi:common:primitives:1.0.0#/$defs/stableVersion" }, "approval": { "type": "string" }, "publication": { "type": "string" } } }
