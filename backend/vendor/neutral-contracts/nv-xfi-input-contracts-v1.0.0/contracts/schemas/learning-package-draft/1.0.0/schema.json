    "laboratoryReferences": { "type": "array", "maxItems": 128, "items": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/laboratoryReference" } },
    "assessmentReferences": { "type": "array", "maxItems": 128, "items": { "$ref": "urn:neuralverse:xfi:contract:learning-package-draft:1.0.0#/$defs/assessmentReference" } },
