NEURALVERSE_ENV=local
NEURALVERSE_APPLICATION_NAME=neuralverse-backend
NEURALVERSE_APPLICATION_VERSION=0.1.0
NEURALVERSE_HOST=127.0.0.1
NEURALVERSE_PORT=8000
NEURALVERSE_LOG_LEVEL=INFO
NEURALVERSE_LOG_FORMAT=console
NEURALVERSE_CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
NEURALVERSE_OPENAPI_ENABLED=true
NEURALVERSE_DOCS_ENABLED=true
NEURALVERSE_DATABASE_ENABLED=false
NEURALVERSE_DATABASE_REQUIRED_FOR_READINESS=false
# Compose defaults are disposable and loopback-only. Replace the URL only in an untracked .env.
# NEURALVERSE_DATABASE_URL=postgresql+psycopg://neuralverse_bip:neuralverse_bip_dev_only@127.0.0.1:55432/neuralverse_backend_bip
NEURALVERSE_DATABASE_POOL_SIZE=5
NEURALVERSE_DATABASE_MAX_OVERFLOW=5
NEURALVERSE_DATABASE_POOL_TIMEOUT_SECONDS=10
NEURALVERSE_DATABASE_POOL_RECYCLE_SECONDS=1800
NEURALVERSE_DATABASE_CONNECT_TIMEOUT_SECONDS=5
NEURALVERSE_DATABASE_STATEMENT_TIMEOUT_MS=5000
NEURALVERSE_DATABASE_ECHO=false
NEURALVERSE_DATABASE_APPLICATION_NAME=neuralverse-backend

# B.4.3 application-level fixture ingestion is disabled by default.
NEURALVERSE_FIXTURE_INGESTION_ENABLED=false
# When enabled, provide process-start HMAC material through an untracked .env or secret manager.
# NEURALVERSE_IDEMPOTENCY_HMAC_ACTIVE_KEY_VERSION=fixture-hmac-2026-01
# NEURALVERSE_IDEMPOTENCY_HMAC_ACTIVE_KEY=<BASE64_32_BYTE_KEY>
# NEURALVERSE_IDEMPOTENCY_HMAC_PREVIOUS_KEYS={}

# Hosted database configuration requires sslmode=verify-full.

# Project-isolated PostgreSQL Compose inputs.
# NEURALVERSE_POSTGRES_DATABASE=neuralverse_backend_bip
# NEURALVERSE_POSTGRES_USER=neuralverse_bip
# NEURALVERSE_POSTGRES_PASSWORD=neuralverse_bip_dev_only
# NEURALVERSE_POSTGRES_PORT=55432
